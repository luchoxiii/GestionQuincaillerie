datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// User & Auth
model User {
  id            String     @id @default(uuid())
  username      String     @unique
  email         String     @unique
  password      String
  firstName     String
  lastName      String
  isActive      Boolean    @default(true)
  tokenVersion  Int        @default(0)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  userRoles    UserRole[]
  cashSessions CashSession[]
  sales        Sale[]
  auditLogs    AuditLog[]
  inventoryCounts InventoryCount[]
  stockTransfersCreated StockTransfer[] @relation("TransferCreator")
  stockTransfersReceived StockTransfer[] @relation("TransferReceiver")
  stockMovements StockMovement[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles       RolePermission[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// Product catalog
model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products    Product[]
  @@index([parentId])
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model UnitOfMeasure {
  id          String    @id @default(uuid())
  name        String
  abbreviation String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Warehouse {
  id          String    @id @default(uuid())
  name        String
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stocks      WarehouseStock[]
  movements   StockMovement[]
  transfersFrom StockTransfer[] @relation("TransferSource")
  transfersTo   StockTransfer[] @relation("TransferDestination")
  inventoryCounts InventoryCount[]
}

model Product {
  id              String    @id @default(uuid())
  code            String    @unique // SKU
  name            String
  description     String?
  categoryId      String?
  brandId         String?
  unitId          String?
  isActive        Boolean   @default(true)
  costPrice       Decimal   @db.Decimal(12, 4)
  profitMargin    Decimal?  @db.Decimal(5, 2)
  salePrice       Decimal   @db.Decimal(12, 4)
  minStock        Decimal?  @db.Decimal(12, 4)
  maxStock        Decimal?  @db.Decimal(12, 4)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category        Category? @relation(fields: [categoryId], references: [id])
  brand           Brand?    @relation(fields: [brandId], references: [id])
  unit            UnitOfMeasure? @relation(fields: [unitId], references: [id])
  
  barcodes        ProductBarcode[]
  images          ProductImage[]
  taxes           ProductTax[]
  stocks          WarehouseStock[]
  stockMovements  StockMovement[]
  priceHistory    PriceHistory[]
  priceListItems  PriceListItem[]
  saleItems       SaleItem[]
  invoiceItems    InvoiceItem[]
  purchaseItems   PurchaseItem[]
  purchaseOrderItems PurchaseOrderItem[]
  countItems      InventoryCountItem[]
  transferItems   StockTransferItem[]

  @@index([categoryId])
  @@index([brandId])
}

model ProductBarcode {
  id        String   @id @default(uuid())
  productId String
  barcode   String   @unique
  type      BarcodeType @default(EAN13)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

enum BarcodeType {
  EAN13
  CODE128
  INTERNAL
  QR
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

model Tax {
  id          String   @id @default(uuid())
  name        String
  rate        Decimal  @db.Decimal(5, 2)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productTaxes ProductTax[]
}

model ProductTax {
  id        String   @id @default(uuid())
  productId String
  taxId     String
  
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tax       Tax      @relation(fields: [taxId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([productId, taxId])
  @@index([productId])
  @@index([taxId])
}

// Inventory
model WarehouseStock {
  id          String   @id @default(uuid())
  warehouseId String
  productId   String
  quantity    Decimal  @db.Decimal(12, 4) @default(0)
  updatedAt   DateTime @updatedAt

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_IN
  INITIAL
  COUNT_ADJUSTMENT
}

model StockMovement {
  id          String   @id @default(uuid())
  warehouseId String
  productId   String
  type        StockMovementType
  quantity    Decimal  @db.Decimal(12, 4) // Positive or negative
  referenceId String?  
  notes       String?
  userId      String?
  createdAt   DateTime @default(now())

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@index([warehouseId])
  @@index([productId])
  @@index([type])
}

// Pricing
model PriceHistory {
  id          String   @id @default(uuid())
  productId   String
  oldCost     Decimal  @db.Decimal(12, 4)
  newCost     Decimal  @db.Decimal(12, 4)
  oldPrice    Decimal  @db.Decimal(12, 4)
  newPrice    Decimal  @db.Decimal(12, 4)
  userId      String?
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model PriceList {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       PriceListItem[]
  customers   Customer[]
}

model PriceListItem {
  id          String   @id @default(uuid())
  priceListId String
  productId   String
  price       Decimal  @db.Decimal(12, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@index([priceListId])
  @@index([productId])
}

// Entities
enum DocumentType {
  DNI
  CUIT
  CUIL
}

enum TaxCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTISTA
  EXENTO
  CONSUMIDOR_FINAL
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  documentType  DocumentType
  documentNum   String
  taxCondition  TaxCondition
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  priceListId   String?
  creditLimit   Decimal? @db.Decimal(12, 4)
  balance       Decimal  @default(0) @db.Decimal(12, 4)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  priceList     PriceList? @relation(fields: [priceListId], references: [id])
  sales         Sale[]
  invoices      Invoice[]
  accountMoves  CustomerAccountMove[]
  payments      CustomerPayment[]

  @@index([priceListId])
  @@index([documentNum])
}

model CustomerAccountMove {
  id          String   @id @default(uuid())
  customerId  String
  type        String   // INVOICE, PAYMENT, NOTE
  amount      Decimal  @db.Decimal(12, 4)
  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([customerId])
}

model CustomerPayment {
  id          String   @id @default(uuid())
  customerId  String
  amount      Decimal  @db.Decimal(12, 4)
  methodId    String
  date        DateTime @default(now())
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer @relation(fields: [customerId], references: [id])
  method      PaymentMethod @relation(fields: [methodId], references: [id])
  @@index([customerId])
  @@index([methodId])
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  documentType  DocumentType
  documentNum   String
  taxCondition  TaxCondition
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  balance       Decimal  @default(0) @db.Decimal(12, 4)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases     Purchase[]
  purchaseOrders PurchaseOrder[]
  accountMoves  SupplierAccountMove[]
  payments      SupplierPayment[]

  @@index([documentNum])
}

model SupplierAccountMove {
  id          String   @id @default(uuid())
  supplierId  String
  type        String   // PURCHASE, PAYMENT, NOTE
  amount      Decimal  @db.Decimal(12, 4)
  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())

  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  @@index([supplierId])
}

model SupplierPayment {
  id          String   @id @default(uuid())
  supplierId  String
  amount      Decimal  @db.Decimal(12, 4)
  methodId    String
  date        DateTime @default(now())
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier    Supplier @relation(fields: [supplierId], references: [id])
  method      PaymentMethod @relation(fields: [methodId], references: [id])
  @@index([supplierId])
  @@index([methodId])
}

enum PaymentMethodCode {
  CASH
  DEBIT
  CREDIT
  TRANSFER
  CHECK
  OTHER
}

model PaymentMethod {
  id          String   @id @default(uuid())
  code        PaymentMethodCode
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salePayments      SalePayment[]
  customerPayments  CustomerPayment[]
  supplierPayments  SupplierPayment[]
  purchasePayments  PurchasePayment[]
  cashMovements     CashMovement[]
}

// Sales
enum SaleStatus {
  COMPLETED
  VOIDED
  RETURNED
  PARTIAL_RETURN
}

model Sale {
  id            String   @id @default(uuid())
  number        Int      @unique @default(autoincrement())
  date          DateTime @default(now())
  status        SaleStatus @default(COMPLETED)
  customerId    String?
  userId        String
  subtotal      Decimal  @db.Decimal(12, 4)
  discount      Decimal  @default(0) @db.Decimal(12, 4)
  taxAmount     Decimal  @default(0) @db.Decimal(12, 4)
  total         Decimal  @db.Decimal(12, 4)
  notes         String?
  cashSessionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer? @relation(fields: [customerId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])
  items         SaleItem[]
  payments      SalePayment[]
  invoice       Invoice?

  @@index([customerId])
  @@index([userId])
  @@index([cashSessionId])
  @@index([status])
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  productId   String
  quantity    Decimal  @db.Decimal(12, 4)
  unitPrice   Decimal  @db.Decimal(12, 4)
  discount    Decimal  @default(0) @db.Decimal(12, 4)
  taxRate     Decimal  @db.Decimal(5, 2)
  taxAmount   Decimal  @db.Decimal(12, 4)
  subtotal    Decimal  @db.Decimal(12, 4)
  total       Decimal  @db.Decimal(12, 4)
  
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id          String   @id @default(uuid())
  saleId      String
  methodId    String
  amount      Decimal  @db.Decimal(12, 4)
  reference   String?

  sale        Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method      PaymentMethod @relation(fields: [methodId], references: [id])

  @@index([saleId])
  @@index([methodId])
}

// Invoicing (AFIP)
model SalePoint {
  id          String   @id @default(uuid())
  number      Int      @unique
  name        String
  isActive    Boolean  @default(true)
  isAfipSync  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices    Invoice[]
}

model InvoiceType {
  id          String   @id @default(uuid())
  code        String   // AFIP code e.g. "001", "006"
  name        String   // e.g. "Factura A", "Factura B"
  letter      String   // A, B, C
  isActive    Boolean  @default(true)
  
  invoices    Invoice[]
}

enum InvoiceStatus {
  PENDING
  AUTHORIZED
  REJECTED
  VOIDED
}

model Invoice {
  id            String   @id @default(uuid())
  saleId        String?  @unique
  customerId    String
  salePointId   String
  invoiceTypeId String
  number        Int?
  date          DateTime @default(now())
  status        InvoiceStatus @default(PENDING)
  cae           String?
  caeDueDate    DateTime?
  subtotal      Decimal  @db.Decimal(12, 4)
  taxAmount     Decimal  @default(0) @db.Decimal(12, 4)
  total         Decimal  @db.Decimal(12, 4)
  afipError     String?
  afipRequest   Json?
  afipResponse  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sale          Sale?       @relation(fields: [saleId], references: [id])
  customer      Customer    @relation(fields: [customerId], references: [id])
  salePoint     SalePoint   @relation(fields: [salePointId], references: [id])
  invoiceType   InvoiceType @relation(fields: [invoiceTypeId], references: [id])
  items         InvoiceItem[]
  taxes         InvoiceTax[]

  @@unique([salePointId, invoiceTypeId, number])
  @@index([customerId])
  @@index([salePointId])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  productId   String
  description String
  quantity    Decimal  @db.Decimal(12, 4)
  unitPrice   Decimal  @db.Decimal(12, 4)
  discount    Decimal  @default(0) @db.Decimal(12, 4)
  subtotal    Decimal  @db.Decimal(12, 4)
  taxRate     Decimal  @db.Decimal(5, 2)
  taxAmount   Decimal  @db.Decimal(12, 4)
  total       Decimal  @db.Decimal(12, 4)
  
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model InvoiceTax {
  id          String   @id @default(uuid())
  invoiceId   String
  taxRate     Decimal  @db.Decimal(5, 2)
  baseAmount  Decimal  @db.Decimal(12, 4)
  taxAmount   Decimal  @db.Decimal(12, 4)
  
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Purchases
enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  number      Int      @unique @default(autoincrement())
  date        DateTime @default(now())
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?
  total       Decimal  @db.Decimal(12, 4)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier    Supplier @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]
  purchases   Purchase[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal  @db.Decimal(12, 4)
  receivedQty     Decimal  @default(0) @db.Decimal(12, 4)
  unitPrice       Decimal  @db.Decimal(12, 4)
  total           Decimal  @db.Decimal(12, 4)
  
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

enum PurchaseStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

model Purchase {
  id              String   @id @default(uuid())
  number          Int      @unique @default(autoincrement())
  date            DateTime @default(now())
  supplierId      String
  purchaseOrderId String?
  invoiceNum      String?
  status          PurchaseStatus @default(RECEIVED)
  subtotal        Decimal  @db.Decimal(12, 4)
  taxAmount       Decimal  @db.Decimal(12, 4)
  total           Decimal  @db.Decimal(12, 4)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  items           PurchaseItem[]
  payments        PurchasePayment[]

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([status])
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchaseId  String
  productId   String
  quantity    Decimal  @db.Decimal(12, 4)
  unitPrice   Decimal  @db.Decimal(12, 4)
  taxRate     Decimal  @db.Decimal(5, 2)
  taxAmount   Decimal  @db.Decimal(12, 4)
  subtotal    Decimal  @db.Decimal(12, 4)
  total       Decimal  @db.Decimal(12, 4)
  
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

model PurchasePayment {
  id          String   @id @default(uuid())
  purchaseId  String
  methodId    String
  amount      Decimal  @db.Decimal(12, 4)
  reference   String?

  purchase    Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  method      PaymentMethod @relation(fields: [methodId], references: [id])

  @@index([purchaseId])
  @@index([methodId])
}

// Cash Management
model CashRegister {
  id          String   @id @default(uuid())
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    CashSession[]
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id              String   @id @default(uuid())
  registerId      String
  userId          String
  status          CashSessionStatus @default(OPEN)
  openedAt        DateTime @default(now())
  closedAt        DateTime?
  openingBalance  Decimal  @db.Decimal(12, 4)
  closingBalance  Decimal? @db.Decimal(12, 4)
  expectedBalance Decimal? @db.Decimal(12, 4)
  difference      Decimal? @db.Decimal(12, 4)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  register        CashRegister @relation(fields: [registerId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  movements       CashMovement[]
  sales           Sale[]

  @@index([registerId])
  @@index([userId])
  @@index([status])
}

enum CashMovementType {
  SALE
  REFUND
  INCOME
  EXPENSE
  WITHDRAWAL
  OPENING
}

model CashMovement {
  id            String   @id @default(uuid())
  sessionId     String
  type          CashMovementType
  amount        Decimal  @db.Decimal(12, 4)
  methodId      String?
  description   String
  referenceId   String?
  createdAt     DateTime @default(now())

  session       CashSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  method        PaymentMethod? @relation(fields: [methodId], references: [id])

  @@index([sessionId])
  @@index([type])
}

// Advanced Inventory
model InventoryCount {
  id          String   @id @default(uuid())
  warehouseId String
  userId      String
  date        DateTime @default(now())
  status      String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  items       InventoryCountItem[]

  @@index([warehouseId])
  @@index([status])
}

model InventoryCountItem {
  id               String   @id @default(uuid())
  inventoryCountId String
  productId        String
  systemQty        Decimal  @db.Decimal(12, 4)
  countedQty       Decimal? @db.Decimal(12, 4)
  difference       Decimal? @db.Decimal(12, 4)

  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id])

  @@index([inventoryCountId])
  @@index([productId])
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model StockTransfer {
  id              String   @id @default(uuid())
  sourceId        String
  destinationId   String
  createdById     String
  receivedById    String?
  status          TransferStatus @default(PENDING)
  shippedAt       DateTime?
  receivedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  source          Warehouse @relation("TransferSource", fields: [sourceId], references: [id])
  destination     Warehouse @relation("TransferDestination", fields: [destinationId], references: [id])
  createdBy       User      @relation("TransferCreator", fields: [createdById], references: [id])
  receivedBy      User?     @relation("TransferReceiver", fields: [receivedById], references: [id])
  items           StockTransferItem[]

  @@index([sourceId])
  @@index([destinationId])
  @@index([status])
}

model StockTransferItem {
  id              String   @id @default(uuid())
  transferId      String
  productId       String
  quantity        Decimal  @db.Decimal(12, 4)
  receivedQty     Decimal? @db.Decimal(12, 4)

  transfer        StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
}

// System
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entity      String
  entityId    String
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  group       String
  type        String   @default("string") // string, number, boolean, json
  description String?
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@index([group])
}
