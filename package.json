{
  "name": "ferreteria-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Gestión Integral para Ferretería",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:api": "pnpm --filter @ferreteria/api run start:dev",
    "dev:web": "pnpm --filter @ferreteria/web run dev",
    "build": "pnpm -r run build",
    "build:shared": "pnpm --filter @ferreteria/shared run build",
    "db:migrate": "pnpm --filter @ferreteria/api run prisma:migrate",
    "db:seed": "pnpm --filter @ferreteria/api run prisma:seed",
    "db:studio": "pnpm --filter @ferreteria/api run prisma:studio",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "clean": "node -e \"const fs=require('fs'); ['node_modules','dist','.turbo','apps/api/dist','apps/web/dist','packages/shared/dist'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}})\""
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
